APP_NAME=Downloader
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Production subdomain: https://downloader.yousiffarra.com
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=downloader
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Shared hosting (Hostinger): use database queue + cron (see DEPLOY.md)
QUEUE_CONNECTION=database

# Local quick testing without cron:
# QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="contact@yousiffarra.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SEO (subdomain / production)
# SEO_SITE_NAME="${APP_NAME}"
# SEO_TAGLINE="Free Online Video Downloader"
# SEO_DESCRIPTION="Download videos from YouTube, TikTok, Twitter/X, and direct file links..."
# SEO_KEYWORDS="youtube downloader, download youtube video, tiktok downloader, ..."
# SEO_PARENT_URL=https://yousiffarra.com
# SEO_PARENT_NAME="Yousif ELFarra"
# SEO_OG_IMAGE=https://downloader.yousiffarra.com/images/logo.png

# Legal / support
# LEGAL_OPERATOR_NAME="Yousif ElFarra"
# LEGAL_BUSINESS_NAME="${APP_NAME}"
# LEGAL_SUPPORT_EMAIL=contact@yousiffarra.com
# LEGAL_SUPPORT_RESPONSE_HOURS=48
# LEGAL_REFUND_WINDOW_DAYS=14
# LEGAL_LAST_UPDATED=2026-07-02

# Hostinger SMTP (production) — create mailbox in hPanel first
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_USERNAME=contact@yousiffarra.com
# MAIL_PASSWORD=your-mailbox-password
# MAIL_ENCRYPTION=ssl
# MAIL_FROM_ADDRESS=contact@yousiffarra.com
# MAIL_FROM_NAME="${APP_NAME}"

# Bank transfer billing (production)
# BILLING_BANK_NAME="Bank of Palestine"
# BILLING_ACCOUNT_HOLDER="Yousif ElFarra"
# BILLING_IBAN=PS00BOPX00000000000000000000
# BILLING_SWIFT=PALSPS22XXX
# BILLING_CURRENCY=USD
# BILLING_EXTRA_INSTRUCTIONS="Include your payment reference in the transfer description."
# BILLING_GRACE_PERIOD_DAYS=7
# BILLING_RECOMMENDED_PLAN_SLUG=pro
# BILLING_ACTIVATION_HOURS=24

# Crypto payments via Plisio (optional — instant auto-activation)
# BILLING_CRYPTO_ENABLED=true
# PLISIO_API_KEY=wYsUNHpymCZwEgXk11TPfpE2Bwz4VTfNNOBhBFEsfkAeHKWY9mAYfauDaHe7HWK-
# PLISIO_DEFAULT_CURRENCY=USDT
# PLISIO_ALLOWED_CURRENCIES=USDT,BTC,LTC
# PLISIO_INVOICE_EXPIRE_MINUTES=60

# Bundled tools in bin/ (leave empty to auto-detect)
# Windows local: bin/yt-dlp.exe | Linux server: bin/yt-dlp (NOT .exe)
# YT_DLP_PATH=
# FFMPEG_PATH=

# Optional: temp folder for yt-dlp (defaults to %LOCALAPPDATA%\yt-dlp-temp on Windows)
# YT_DLP_TEMP_PATH=

# Linux server: Python 3.10+ required (Hostinger: /opt/alt/python311/bin/python3.11)
YT_DLP_PYTHON=/opt/alt/python311/bin/python3.11

# Linux: Deno for YouTube JS challenges (auto-detects bin/deno after setup-linux.sh)
# Leave unset unless auto-detect fails — a wrong path here breaks YouTube downloads.
# YT_DLP_DENO_PATH=

# Optional: Netscape cookies.txt when YouTube blocks the server IP
# Upload to storage/app/yt-dlp-cookies.txt (auto-detected) or set full path:
# YT_DLP_COOKIES_PATH=/home/you/.../storage/app/yt-dlp-cookies.txt

# Production shared hosting: use sync so downloads don't need a queue worker
# QUEUE_CONNECTION=sync
